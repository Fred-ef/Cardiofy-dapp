{
  "name": "backend",
  "version": "0.1.0",
  "description": "Cardiofy blockchain module: REST API gateway towards the Notary smart contract",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test && npm run test:integration",
    "type-check": "tsc --noEmit",
    "type-check:all": "tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/index.js",
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/pg": "^8.16.0",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^4.0.18",
    "drizzle-kit": "^0.31.9",
    "eslint": "^8.57.1",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.3",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@cardiofy/shared": "*",
    "zod-openapi": "^6.0.0",
    "cors": "^2.8.6",
    "croner": "^10.0.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "ethers": "^6.14.4",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.8",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.11.3",
    "swagger-ui-express": "^5.0.1",
    "tsyringe": "^4.10.0",
    "zod": "^4.3.6"
  }
}
