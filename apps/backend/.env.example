# Server
PORT=3001
NODE_ENV=development
SHUTDOWN_TIMEOUT_MS=10000

# Database
DATABASE_URL=postgres://cardiofy:cardiofy@localhost:5432/cardiofy
DATABASE_MAX_CONN=10

# Notary on-chain — opzionali: se assenti il job batch resta disabilitato e il gateway è una NoOp.
NOTARY_RPC_URL=
NOTARY_PRIVATE_KEY=
NOTARY_CONTRACT_ADDRESS=
NOTARY_DEPLOY_BLOCK=
NOTARY_CHAIN_ID=11155111
NOTARY_CONFIRMATIONS=3

# Batch / cron schedules (croner format)
BATCH_CRON=0 0 * * *
RECONCILE_CRON=*/5 * * * *

# Audit info (esposte da GET /chain/info)
PUBLIC_RPC_URL=https://rpc.sepolia.org
PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io

# Auth core ↔ modulo. AUTH_ENABLED=false → middleware no-op (dev locale).
# In produzione: AUTH_ENABLED=true + CORE_AUTH_TOKEN >= 32 chars (es. `openssl rand -hex 32`).
AUTH_ENABLED=false
CORE_AUTH_TOKEN=
