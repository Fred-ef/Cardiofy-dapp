# URL base del backend Cardiofy (prefix /api/v1 aggiunto automaticamente)
VITE_API_BASE_URL=http://localhost:3001

# Opzionale: RPC alternativo per le letture on-chain nel browser, se il
# recommendedRPC restituito da /chain/info non consente richieste CORS
# dal browser (es. rpc.sepolia.org a volte le rifiuta). Esempi CORS-friendly:
# un endpoint Alchemy/Infura/Ankr dedicato.
VITE_RPC_URL_OVERRIDE=
